#!/usr/bin/env python3
"""Fetch, sign, and sync a branch locally, then push it back to its source remote."""

from __future__ import annotations

import argparse
import hashlib
from datetime import datetime, timezone
import os
from pathlib import Path, PurePosixPath
import re
import shlex
import stat
import subprocess
import sys
import uuid
from urllib.parse import unquote, urlsplit


class Error(Exception):
    pass


def git(*args: str, cwd: str | None = None, data: bytes | None = None,
        env: dict[str, str] | None = None, check: bool = True) -> bytes:
    result = subprocess.run(
        ["git", "--no-replace-objects", *args], cwd=cwd, input=data, env=env,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    if check and result.returncode:
        diagnostics = [output.decode(errors="replace").strip()
                       for output in (result.stdout, result.stderr)]
        raise Error("\n".join(message for message in diagnostics if message))
    return result.stdout


def oid(ref: str, required: bool = True) -> str:
    return git("rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}",
               check=required).decode().strip()


def fetch_upstream(spec: str | None) -> tuple[str, str]:
    if spec is None:
        # Inspect the actual remote, rather than trusting a potentially stale
        # origin/HEAD or assuming that origin/master has already been fetched.
        advertised = git("ls-remote", "--heads", "--", "origin",
                         "refs/heads/master", "refs/heads/main").decode().splitlines()
        branches = {line.split()[1] for line in advertised}
        name = next((b for b in ("master", "main") if f"refs/heads/{b}" in branches), None)
        if name is None:
            raise Error("No master/main branch on origin; pass --upstream REMOTE/BRANCH")
        spec = f"origin/{name}"
    remote, separator, branch = spec.partition("/")
    if not separator or not remote or not branch:
        raise Error("--upstream must be REMOTE/BRANCH")
    git("remote", "get-url", "--", remote)
    git("check-ref-format", f"refs/heads/{branch}")
    ref = f"refs/remotes/{remote}/{branch}"
    git("fetch", "--no-tags", "--no-recurse-submodules", "--", remote,
        f"+refs/heads/{branch}:{ref}")
    tip = oid(ref)
    print(f"Fetched upstream {spec}: {tip}", flush=True)
    return ref, tip


def fetch_stacked_base(source: str, upstream: str, source_remote: str) -> tuple[str, str] | None:
    # A different author below our own commits suggests a stacked branch.
    # Require a freshly advertised branch tip as evidence; authorship alone
    # must never exclude a contributor's commit from the signing range.
    history = git("log", "--first-parent", "--no-show-signature", "--format=%H%x00%ae", source,
                  f"^{upstream}").splitlines()
    if not history:
        return None
    identity = git("var", "GIT_AUTHOR_IDENT", check=False).strip()
    match = re.fullmatch(rb".* <([^<>]*)> \d+ [+-]\d{4}", identity)
    if not match:
        return None
    own_email = match[1].lower()
    own_commits = False
    candidate = None
    for entry in history:
        commit, email = entry.split(b"\0", 1)
        if email.lower() != own_email:
            if own_commits:
                candidate = commit.decode()
            break
        own_commits = True
    if candidate is None:
        return None
    remotes = git("remote").decode().splitlines()
    # Cached refs can prioritize lookups, but never establish the base. Even a
    # locally matching tip must be advertised by the remote before we use it.
    hints = git("for-each-ref", "--format=%(refname)", "--points-at", candidate,
                "refs/remotes").decode().splitlines()
    remotes.sort(key=lambda r: not any(ref.startswith(f"refs/remotes/{r}/") for ref in hints))
    for remote in remotes:
        if remote == source_remote:
            continue
        try:
            advertised = git("ls-remote", "--heads", "--", remote).decode().splitlines()
        except Error as exc:
            print(f"Could not check stacked base on {remote}: {exc}", file=sys.stderr, flush=True)
            continue
        for entry in advertised:
            tip, branch = entry.split()
            if tip != candidate:
                continue
            name = branch.removeprefix("refs/heads/")
            ref = f"refs/remotes/{remote}/{name}"
            git("fetch", "--no-tags", "--no-recurse-submodules", "--", remote,
                f"+{branch}:{ref}")
            fetched = oid(ref)
            # Allow a fast-forward since advertisement, but never silently
            # accept a different history after a racing force push.
            if git("merge-base", candidate, fetched, check=False).decode().strip() != candidate:
                raise Error(f"Stacked base changed on {remote}/{name}; retry or pass --base REF")
            print(f"Protected stacked base {remote}/{name}: {candidate}", flush=True)
            return f"{remote}/{name}", candidate
    return None


def pr_branch(pr: str, repo: str | None) -> str:
    if not (re.fullmatch(r"[1-9]\d*", pr) or
            re.fullmatch(r"https://[^/]+/[^/]+/[^/]+/pull/[1-9]\d*/?", pr)):
        raise Error("--pr must be a PR number or a full pull request URL")
    command = ["gh", "pr", "view", pr, "--json", "headRefName", "--jq", ".headRefName"]
    if repo:
        command.extend(["--repo", repo])
    result = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode:
        raise Error(f"GitHub PR lookup failed: {result.stderr.strip()}")
    branch = result.stdout.strip()
    if not branch or branch == "null":
        raise Error("GitHub PR lookup returned no head branch")
    print(f"PR {pr}: branch {branch}", flush=True)
    return branch


def worktree_path(listing: bytes, ref: str) -> str | None:
    for entry in listing.split(b"\0\0"):
        fields = entry.split(b"\0")
        if os.fsencode(f"branch {ref}") in fields:
            return os.fsdecode(fields[0].removeprefix(b"worktree "))
    return None


def branch_worktree(ref: str) -> str | None:
    return worktree_path(git("worktree", "list", "--porcelain", "-z"), ref)


def mirror_remote_worktree(remote: str, ref: str) -> str:
    url = git("remote", "get-url", "--", remote).decode().strip()
    options: list[str] = []
    if url.startswith("ssh://"):
        parsed = urlsplit(url)
        host = parsed.hostname
        if not host or parsed.password is not None:
            raise Error("Cannot inspect this SSH remote; pass --worktree PATH")
        if parsed.username:
            host = f"{unquote(parsed.username)}@{host}"
        if parsed.port:
            options = ["-p", str(parsed.port)]
        repository = unquote(parsed.path)
        if repository.startswith("/~"):
            repository = repository[1:]
    else:
        match = re.fullmatch(r"((?:[^/@:]+@)?(?:\[[^]]+\]|[^/:]+)):(.+)", url)
        if not match or "://" in url:
            raise Error("Automatic worktree paths require an SSH remote; pass --worktree PATH")
        host, repository = match.groups()
    if repository == "~":
        directory = '"$HOME"'
    elif repository.startswith("~/"):
        directory = '"$HOME"/' + shlex.quote(repository[2:])
    else:
        directory = shlex.quote(repository)
    command = f'printf "%s\\0" "$HOME"; git -C {directory} worktree list --porcelain -z'
    result = subprocess.run(["ssh", *options, "--", host, command],
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode:
        raise Error(f"Remote worktree lookup failed: {result.stderr.decode(errors='replace').strip()}; "
                    "pass --worktree PATH to choose a local path explicitly")
    home, separator, listing = result.stdout.partition(b"\0")
    if not separator or not PurePosixPath(os.fsdecode(home)).is_absolute():
        raise Error("Remote worktree lookup returned no home directory; pass --worktree PATH")
    path = worktree_path(listing, ref)
    if path is None:
        raise Error(f"No worktree for {ref.removeprefix('refs/heads/')} on {remote}; pass --worktree PATH")
    try:
        relative = PurePosixPath(path).relative_to(PurePosixPath(os.fsdecode(home)))
    except ValueError as exc:
        raise Error(f"Remote worktree {path} is outside its home directory; pass --worktree PATH") from exc
    if ".." in relative.parts:
        raise Error("Remote worktree path contains '..'; pass --worktree PATH")
    return str(Path.home().joinpath(*relative.parts))


def worktree_dirty(path: str) -> bool:
    return bool(git("status", "--porcelain", "--untracked-files=all",
                    "--ignore-submodules=none", cwd=path))


def check_worktree(path: str | None, ref: str, allow_dirty: bool = False) -> None:
    if path is None:
        return
    if git("symbolic-ref", "--quiet", "HEAD", cwd=path).decode().strip() != ref:
        raise Error(f"Branch checkout changed in {path}")
    for state in ("rebase-merge", "rebase-apply", "MERGE_HEAD", "CHERRY_PICK_HEAD",
                  "REVERT_HEAD", "sequencer", "BISECT_START"):
        state_path = os.fsdecode(git("rev-parse", "--git-path", state, cwd=path).strip())
        if (Path(path) / state_path).exists():
            raise Error(f"Git operation in progress in {path}: {state}")
    if git("ls-files", "--unmerged", "-z", cwd=path):
        raise Error(f"Unresolved conflicts in branch worktree: {path}")
    if not allow_dirty and worktree_dirty(path):
        raise Error(f"Branch worktree is dirty: {path}")


def drop_saved_stash(path: str, stash: str, recovery: str) -> None:
    # Stashes are shared by linked worktrees. Locate ours by object ID rather
    # than assuming it is still stash@{0}.
    for line in git("stash", "list", "--format=%H %gd", cwd=path).decode().splitlines():
        commit, selector = line.split(" ", 1)
        if commit == stash:
            git("stash", "drop", selector, cwd=path)
            break
    git("update-ref", "-d", recovery, stash)


def remove_restored_untracked(path: str, stash: str) -> None:
    untracked = oid(f"{stash}^3", required=False)
    if not untracked:
        return
    # A failed stash application can already have restored some untracked
    # files. Remove only those matching the saved files before applying again.
    # Never run git clean, which could delete unrelated or ignored files.
    for entry in git("ls-tree", "-r", "-z", untracked).split(b"\0"):
        if not entry:
            continue
        metadata, name = entry.split(b"\t", 1)
        mode, _, blob = metadata.split()
        target = Path(path) / os.fsdecode(name)
        if not os.path.lexists(target):
            continue
        saved = git("cat-file", "blob", blob.decode())
        file_mode = target.lstat().st_mode
        if mode == b"120000" and stat.S_ISLNK(file_mode):
            matches = os.fsencode(os.readlink(target)) == saved
        elif mode != b"120000" and stat.S_ISREG(file_mode):
            matches = target.read_bytes() == saved
        else:
            matches = False
        if not matches:
            raise Error(f"Cannot safely remove changed untracked file during rollback: {target}")
        target.unlink()


def sync_worktree(path: str, ref: str, previous: str, signed: str, backup: str) -> str | None:
    check_worktree(path, ref, allow_dirty=True)
    stash = None
    recovery = f"{backup}/stash"
    if worktree_dirty(path):
        old_stash = oid("refs/stash", required=False)
        git("stash", "push", "--include-untracked", "--message", f"git-fetch-sign {backup}", cwd=path)
        stash = oid("refs/stash")
        if stash == old_stash:
            raise Error("Git could not stash the worktree changes; local branch left unchanged")
        git("update-ref", recovery, stash, "")
        print(f"Stashed worktree changes: {recovery}", flush=True)
    try:
        check_worktree(path, ref)
    except Error as exc:
        # For example, stash cannot clean dirty submodule working directories.
        # Leave its saved data intact instead of resetting a still-dirty tree.
        raise Error(f"{exc}; saved changes retained at {recovery}" if stash else str(exc)) from exc
    try:
        git("reset", "--keep", signed, cwd=path)
        if stash:
            # Apply by object ID, preserving the index. Drop only after success:
            # this has pop semantics without risking a different worktree's stash.
            git("stash", "apply", "--index", stash, cwd=path)
    except (Error, OSError, KeyboardInterrupt) as exc:
        if not stash:
            raise
        print("Sync or stash restoration failed; reverting the sync...", flush=True)
        try:
            current = git("symbolic-ref", "--quiet", "HEAD", cwd=path).decode().strip()
            if current != ref or oid(ref) not in (previous, signed):
                raise Error("Branch changed during sync; refusing to reset it")
            # Original tracked changes are saved in our stash. Discard only the
            # failed application, then restore the original branch and changes.
            git("reset", "--hard", previous, cwd=path)
            remove_restored_untracked(path, stash)
            git("stash", "apply", "--index", stash, cwd=path)
        except (Error, OSError, KeyboardInterrupt) as rollback:
            raise Error(f"{exc}; recovery failed: {rollback}. "
                        f"Saved changes retained at {recovery} ({stash})") from rollback
        drop_saved_stash(path, stash, recovery)
        raise Error(f"{exc}; sync reverted and original worktree changes restored") from exc
    if stash:
        # Keep the original snapshot until the push succeeds. A later push
        # failure must restore its exact index and untracked files at previous.
        print("Restored stashed worktree changes", flush=True)
    return stash



def worktree_state(path: str) -> tuple[bytes, bytes, tuple]:
    untracked = []
    for name in git("ls-files", "--others", "--exclude-standard", "-z", cwd=path).split(b"\0"):
        if not name:
            continue
        target = Path(path) / os.fsdecode(name)
        mode = target.lstat().st_mode
        data = os.fsencode(os.readlink(target)) if stat.S_ISLNK(mode) else target.read_bytes()
        untracked.append((name, mode, hashlib.sha256(data).digest()))
    return (git("diff", "--cached", "--binary", "--no-ext-diff", cwd=path),
            git("diff", "--binary", "--no-ext-diff", cwd=path), tuple(untracked))


def rollback_sync(path: str, ref: str, previous: str, signed: str,
                  backup: str, stash: str | None, expected_state: tuple) -> None:
    check_worktree(path, ref, allow_dirty=True)
    current_path = branch_worktree(ref)
    if oid(ref) != signed or current_path is None or Path(current_path).resolve() != Path(path).resolve():
        raise Error("Branch changed during sync; refusing to reset it")
    if stash:
        if worktree_state(path) != expected_state:
            raise Error("Worktree changed during push; original changes retained at " + backup + "/stash")
        # The original index, tracked edits, and untracked files remain saved.
        # Discard only the verified restored application on the signed tip,
        # then reapply that original snapshot against its original base.
        git("reset", "--hard", previous, cwd=path)
        remove_restored_untracked(path, stash)
        git("stash", "apply", "--index", stash, cwd=path)
        drop_saved_stash(path, stash, backup + "/stash")
    else:
        # Preserve concurrent edits and refuse any conflicting reset.
        git("reset", "--keep", previous, cwd=path)


def warn_skip(branch: str, reason: str, override: str) -> None:
    print(f"git-fetch-sign: warning: skipping {branch}: {reason}; "
          f"use {override} to override", file=sys.stderr, flush=True)


def commit_parts(raw: bytes) -> tuple[list[bytes], bytes]:
    header, message = raw.split(b"\n\n", 1)
    fields: list[bytes] = []
    for line in header.split(b"\n"):
        if line.startswith(b" "):
            fields[-1] += b"\n" + line
        else:
            fields.append(line)
    return fields, message


def unsigned(raw: bytes) -> bytes:
    fields, message = commit_parts(raw)
    return b"\n".join(f for f in fields if f.split(b" ", 1)[0]
                      not in (b"gpgsig", b"gpgsig-sha256")) + b"\n\n" + message


def sign_commit(old: str, rewritten: dict[str, str]) -> str:
    raw = git("cat-file", "commit", old)
    fields, message = commit_parts(raw)
    if any(f.split(b" ", 1)[0] in (b"gpgsig", b"gpgsig-sha256") for f in fields):
        # Keep existing signatures and IDs when their payload is unchanged.
        # Only verify signatures created by this utility.
        parents = [f.split(b" ", 1)[1].decode() for f in fields if f.startswith(b"parent ")]
        if all(rewritten.get(parent, parent) == parent for parent in parents):
            return old
    env = os.environ.copy()
    args: list[str] = []
    expected: list[bytes] = []
    encoding = "UTF-8"
    for field in fields:
        kind, value = field.split(b" ", 1)
        if kind in (b"gpgsig", b"gpgsig-sha256"):
            continue
        if kind == b"tree":
            args.insert(0, value.decode())
        elif kind == b"parent":
            parent = rewritten.get(value.decode(), value.decode())
            args.extend(["-p", parent])
            field = b"parent " + parent.encode()
        elif kind in (b"author", b"committer"):
            match = re.fullmatch(rb"(.*) <([^<>]*)> (\d+ [+-]\d{4})", value)
            if not match:
                raise Error(f"Unsupported {kind.decode()} identity in {old}")
            prefix = "GIT_" + kind.decode().upper()
            env[prefix + "_NAME"] = os.fsdecode(match[1])
            env[prefix + "_EMAIL"] = os.fsdecode(match[2])
            env[prefix + "_DATE"] = "@" + match[3].decode()
        elif kind == b"encoding":
            encoding = value.decode("ascii")
        else:
            raise Error(f"Unsupported commit header {kind.decode(errors='replace')} in {old}")
        expected.append(field)
    new = git("-c", f"i18n.commitEncoding={encoding}", "commit-tree", *args,
              "-S", "-F", "-", data=message, env=env).decode().strip()
    if unsigned(git("cat-file", "commit", new)) != b"\n".join(expected) + b"\n\n" + message:
        raise Error(f"Signing unexpectedly changed commit metadata or contents: {old}")
    git("verify-commit", new)
    return new


def push_signed(remote: str, ref: str, source: str, signed: str) -> None:
    # updateInstead handles both primary and linked remote worktrees. Applying
    # it to this receive-pack invocation avoids changing remote configuration
    # or temporarily leaving the remote worktree on a detached HEAD.
    git("-c", "push.followTags=false", "-c", f"remote.{remote}.mirror=false",
        "push", f"--force-with-lease={ref}:{source}", "--recurse-submodules=no",
        "--receive-pack=git -c receive.denyCurrentBranch=updateInstead receive-pack",
        "--", remote, f"{signed}:{ref}")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("branch", nargs="?", help="Branch name (default: current worktree's branch; or use --pr)")
    parser.add_argument("--pr", help="Look up the branch via GitHub's API using a PR number or URL")
    parser.add_argument("--repo", help="GitHub repository for --pr NUMBER (default: gh repository context)")
    parser.add_argument("--worktree", type=Path, help="Create the missing worktree at PATH (default: mirror SSH remote path)")
    parser.add_argument("--remote", required=True, help="Configured remote to fetch from and push back to")
    parser.add_argument("--upstream", help="Upstream branch to fetch and protect (default: origin/master, or origin/main)")
    parser.add_argument("--base", help="Stacked base ref to exclude (default: detect a published parent branch)")
    parser.add_argument("--allow-dirty", action="store_true", help="Stash and restore local edits instead of skipping dirty worktrees")
    parser.add_argument("--allow-unpushed", action="store_true", help="Allow replacement of local commits absent from the freshly fetched source branch")
    parser.add_argument("--no-push", action="store_true", help="Keep the signed branch local instead of pushing it back")
    parser.add_argument("--dry-run", action="store_true", help="Fetch and show commits without signing, syncing, or pushing")
    args = parser.parse_args()
    if args.branch is not None and args.pr is not None:
        parser.error("BRANCH and --pr NUMBER/URL are mutually exclusive")
    if args.repo is not None and args.pr is None:
        parser.error("--repo requires --pr")
    if args.pr is not None:
        args.branch = pr_branch(args.pr, args.repo)
    elif args.branch is None:
        git("rev-parse", "--git-dir")
        current = git("symbolic-ref", "--quiet", "HEAD", check=False).decode().strip()
        if not current.startswith("refs/heads/"):
            raise Error("Detached HEAD; pass BRANCH or --pr NUMBER/URL")
        args.branch = current.removeprefix("refs/heads/")
    ref = f"refs/heads/{args.branch}"
    git("check-ref-format", ref)
    if args.branch.startswith("-"):
        raise Error("Branch name must not start with '-'")
    if git("rev-parse", "--is-shallow-repository").strip() == b"true":
        raise Error("A complete repository is required; unshallow it first")
    # Require a configured remote rather than interpreting this option as a URL.
    git("remote", "get-url", "--", args.remote)
    previous = oid(ref, required=False)
    checkout = branch_worktree(ref)
    new_worktree = os.path.abspath(args.worktree.expanduser()) if args.worktree else None
    if checkout:
        if new_worktree and Path(checkout).resolve() != Path(new_worktree).resolve():
            raise Error(f"Branch already has a worktree at {checkout}; --worktree must match it")
    else:
        if new_worktree is None:
            new_worktree = mirror_remote_worktree(args.remote, ref)
            print(f"Mirroring remote worktree path: {new_worktree}", flush=True)
        if os.path.lexists(new_worktree):
            raise Error(f"Worktree destination already exists: {new_worktree}; pass --worktree PATH to choose another")
    check_worktree(checkout, ref, allow_dirty=True)
    if checkout and not args.allow_dirty and worktree_dirty(checkout):
        warn_skip(args.branch, "uncommitted or untracked changes", "--allow-dirty")
        return
    upstream_ref, upstream_tip = fetch_upstream(args.upstream)
    base_ref = args.base or upstream_ref
    base_tip = oid(base_ref)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    backup = f"refs/fetch-sign/{stamp}-{uuid.uuid4().hex[:8]}"
    # A unique source ref avoids FETCH_HEAD races and keeps the fetched tip recoverable.
    git("fetch", "--no-tags", "--no-recurse-submodules", "--", args.remote,
        f"refs/heads/{args.branch}:{backup}/source")
    source = oid(f"{backup}/source")
    if previous and not args.allow_unpushed and git("rev-list", "-1", previous, f"^{source}").strip():
        warn_skip(args.branch, f"unpushed or divergent commits relative to {args.remote}/{args.branch}",
                  "--allow-unpushed")
        git("update-ref", "-d", f"{backup}/source", source)
        return
    if not git("merge-base", "--all", upstream_tip, source, check=False).strip():
        raise Error("Fetched branch and upstream have no shared history; local branch left unchanged")
    if args.base is None:
        inferred = fetch_stacked_base(source, upstream_tip, args.remote)
        if inferred is not None:
            base_ref, base_tip = inferred
    # Exclude the whole upstream history, including commits brought in through
    # merge parents. A merge-base cutoff can incorrectly include those commits.
    commits = git("rev-list", "--reverse", "--topo-order", source,
                  f"^{upstream_tip}", f"^{base_tip}").decode().splitlines()
    print(f"Fetched {args.remote}/{args.branch}: {source}", flush=True)
    print(f"Protected upstream: {upstream_ref}; base: {base_ref}; {len(commits)} commit(s)", flush=True)
    for commit in commits:
        subject = git("show", "-s", "--no-show-signature", "--format=%s", commit).decode(errors="replace").strip()
        print(f"  {commit[:12]} {subject}", flush=True)
    if checkout is None:
        print(f"Will create worktree: {new_worktree}", flush=True)
    if args.dry_run:
        git("update-ref", "-d", f"{backup}/source", source)
        return
    if previous:
        git("update-ref", f"{backup}/previous", previous, "")
    print(f"Recovery refs: {backup}/{{source,previous,signed}}", flush=True)
    rewritten: dict[str, str] = {}
    for i, commit in enumerate(commits, 1):
        rewritten[commit] = sign_commit(commit, rewritten)
        action = "Kept signed commit" if rewritten[commit] == commit else "Signed"
        print(f"{action} {i}/{len(commits)}: {rewritten[commit]}", flush=True)
    signed = rewritten.get(source, source)
    git("update-ref", f"{backup}/signed", signed, "")
    # Recheck just before touching the branch; never discard working tree edits.
    if oid(ref, required=False) != previous or branch_worktree(ref) != checkout:
        raise Error("Local branch changed during signing; local branch left unchanged")
    check_worktree(checkout, ref, allow_dirty=True)
    if checkout and not args.allow_dirty and worktree_dirty(checkout):
        warn_skip(args.branch, "worktree became dirty during signing", "--allow-dirty")
        return
    stash = None
    created = checkout is None
    if checkout:
        stash = sync_worktree(checkout, ref, previous, signed, backup)
    else:
        # Create only after all commits pass signing checks. Do not force an
        # existing directory or branch checked out by another worktree.
        if previous:
            git("worktree", "add", "--", new_worktree, args.branch)
            check_worktree(new_worktree, ref)
            git("reset", "--keep", signed, cwd=new_worktree)
        else:
            git("worktree", "add", "-b", args.branch, "--", new_worktree, signed)
        checkout = new_worktree
    print(f"Updated {args.branch}: {signed}")
    print(f"Updated worktree: {checkout}")
    if previous:
        print(f"Previous local tip: {backup}/previous")
    expected_state = worktree_state(checkout) if stash else ()
    try:
        if args.no_push:
            print("No commits pushed (--no-push)")
        else:
            push_signed(args.remote, ref, source, signed)
            print(f"Pushed signed branch to {args.remote}/{args.branch}: {signed}")
    except (Error, OSError, KeyboardInterrupt) as exc:
        try:
            if previous:
                rollback_sync(checkout, ref, previous, signed, backup, stash, expected_state)
            if created:
                # Remove only our new, clean worktree. A concurrent checkout,
                # commit, or edit prevents removal and leaves recovery refs.
                check_worktree(checkout, ref)
                expected = previous or signed
                current_path = branch_worktree(ref)
                if oid(ref) != expected or current_path is None or Path(current_path).resolve() != Path(checkout).resolve():
                    raise Error("New worktree changed; refusing to remove it")
                git("worktree", "remove", "--", checkout)
                if not previous:
                    git("update-ref", "-d", ref, signed)
        except (Error, OSError, KeyboardInterrupt) as recovery:
            raise Error(f"push to {args.remote} failed: {exc}; recovery failed: {recovery}. "
                        f"Recovery refs retained at {backup}") from recovery
        raise Error(f"push to {args.remote} failed: {exc}; local sync reverted to its previous state. "
                    f"Recovery refs retained at {backup}") from exc
    if stash:
        drop_saved_stash(checkout, stash, backup + "/stash")



if __name__ == "__main__":
    try:
        main()
    except (Error, OSError, ValueError) as exc:
        print(f"git-fetch-sign: {exc}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        print("git-fetch-sign: interrupted", file=sys.stderr)
        sys.exit(130)
