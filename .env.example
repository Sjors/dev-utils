# Copy to .env in your working directory, or select with --env-file FILE.
# Environment variables override this file; command-line options override both.
# Values are literal (no $HOME or command expansion). Quotes and comments work.
# Credential paths support ~/; relative paths are relative to this file.
SIGNAPPLE_CERTIFICATE=~/dev/signapple/sv2-tp.p12
SIGNAPPLE_API_KEY=~/dev/AuthKey_YOURKEYID.p8
SIGNAPPLE_KEY_ID=YOURKEYID
SIGNAPPLE_ISSUER=YOUR_ISSUER_UUID

# Omit to prompt once for the signing passphrase.
# SIGNAPPLE_PASSPHRASE='your signing passphrase'
# The API key defaults to the signing passphrase. Uncomment for an unencrypted key.
# SIGNAPPLE_NOTARY_PASSPHRASE=''
